# Sources are fetched explicitly by `just deps`, or supplied by the Nix derivation.
file(READ "${PROJECT_SOURCE_DIR}/dependencies.json" vsim_dependencies)
set(vsim_source_dependencies jolt)
if(VSIM_BUILD_3D)
  list(APPEND vsim_source_dependencies nvrhi vulkan_headers)
endif()
if(VSIM_BUILD_EDITOR AND VSIM_BUILD_3D AND VSIM_BUILD_EDITOR_GUI)
  list(APPEND vsim_source_dependencies imgui imguizmo)
endif()
foreach(name IN LISTS vsim_source_dependencies)
  string(JSON revision GET "${vsim_dependencies}" "${name}" revision)
  string(TOUPPER "${name}" upper_name)
  set(VSIM_${upper_name}_SOURCE "${PROJECT_SOURCE_DIR}/.cache/dependencies/${name}-${revision}"
      CACHE PATH "Pinned ${name} source directory")
  if(NOT IS_DIRECTORY "${VSIM_${upper_name}_SOURCE}")
    message(FATAL_ERROR "Missing ${name} sources. Run 'just deps' in the Nix shell first.")
  endif()
endforeach()

# Jolt is a static library, with baseline CPU instructions and no global flag overrides.
set(OVERRIDE_CXX_FLAGS OFF CACHE BOOL "" FORCE)
set(INTERPROCEDURAL_OPTIMIZATION OFF CACHE BOOL "" FORCE)
set(ENABLE_ALL_WARNINGS OFF CACHE BOOL "" FORCE)
set(ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
set(DEBUG_RENDERER_IN_DEBUG_AND_RELEASE OFF CACHE BOOL "" FORCE)
set(PROFILER_IN_DEBUG_AND_RELEASE OFF CACHE BOOL "" FORCE)
set(FLOATING_POINT_EXCEPTIONS_ENABLED OFF CACHE BOOL "" FORCE)
# UBSan's virtual-call checks in the adapter need Jolt's C++ type information.
set(CPP_RTTI_ENABLED ${VSIM_SANITIZERS} CACHE BOOL "" FORCE)
foreach(feature IN ITEMS USE_SSE4_1 USE_SSE4_2 USE_AVX USE_AVX2 USE_AVX512 USE_LZCNT USE_TZCNT USE_F16C USE_FMADD)
  set(${feature} OFF CACHE BOOL "" FORCE)
endforeach()
add_subdirectory("${VSIM_JOLT_SOURCE}/Build" third_party/jolt EXCLUDE_FROM_ALL SYSTEM)
if(VSIM_SANITIZERS AND NOT MSVC)
  target_compile_options(Jolt PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer)
endif()

if(VSIM_BUILD_3D)
  set(VULKAN_HEADERS_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
  add_subdirectory("${VSIM_VULKAN_HEADERS_SOURCE}" third_party/vulkan_headers EXCLUDE_FROM_ALL SYSTEM)
  set(NVRHI_WITH_VULKAN ON CACHE BOOL "" FORCE)
  set(NVRHI_WITH_DX11 OFF CACHE BOOL "" FORCE)
  set(NVRHI_WITH_DX12 OFF CACHE BOOL "" FORCE)
  set(NVRHI_WITH_NVAPI OFF CACHE BOOL "" FORCE)
  set(NVRHI_WITH_VALIDATION ON CACHE BOOL "" FORCE)
  set(NVRHI_FETCH_VULKAN_HEADERS OFF CACHE BOOL "" FORCE)
  set(NVRHI_INSTALL OFF CACHE BOOL "" FORCE)
  add_subdirectory("${VSIM_NVRHI_SOURCE}" third_party/nvrhi EXCLUDE_FROM_ALL SYSTEM)
  # Upstream static backend archives reference symbols from the common archive.
  target_link_libraries(nvrhi_vk PUBLIC nvrhi)
endif()
