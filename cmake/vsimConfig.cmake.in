@PACKAGE_INIT@

# VSim headless engine core. Link vsim::core; it carries vsim::Jolt, glm,
# nlohmann_json, and the Lua library it was built against.
include(CMakeFindDependencyMacro)
# Hints point at the packages this SDK was built with, so consumers need no
# CMAKE_PREFIX_PATH when those are still present (they are in a Nix store).
find_dependency(glm 1.0 CONFIG HINTS "@glm_DIR@")
find_dependency(nlohmann_json 3.11 CONFIG HINTS "@nlohmann_json_DIR@")
# A 3D build also exports vsim::renderer (offscreen or windowed Vulkan rendering),
# which needs GLFW and the Vulkan loader from the consumer's environment.
set(VSIM_SDK_RENDERER @VSIM_SDK_RENDERER@)
if(VSIM_SDK_RENDERER)
  find_dependency(glfw3 3.4 CONFIG HINTS "@glfw3_DIR@")
  if(NOT Vulkan_LIBRARY AND EXISTS "@Vulkan_LIBRARY@")
    set(Vulkan_LIBRARY "@Vulkan_LIBRARY@")
    set(Vulkan_INCLUDE_DIR "@Vulkan_INCLUDE_DIR@")
  endif()
  find_dependency(Vulkan 1.3)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/vsimTargets.cmake")

set_and_check(VSIM_INCLUDE_DIR "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@")
set_and_check(VSIM_LIBRARY_DIR "@PACKAGE_CMAKE_INSTALL_LIBDIR@")
set(VSIM_GLM_INCLUDE_DIRS "@VSIM_GLM_INCLUDE_DIRS@")
set(VSIM_JSON_INCLUDE_DIRS "@VSIM_JSON_INCLUDE_DIRS@")
set(VSIM_GLM_LIBRARY "@VSIM_GLM_LIBRARY@")
set(VSIM_LUA_LIBRARIES "@VSIM_LUA_LIBRARIES@")
# Absolute paths of the renderer's shared dependencies (GLFW, the Vulkan loader), for
# consumers that generate their own link lines (pkg-config files, build scripts).
set(VSIM_RENDERER_LIBRARIES "")
if(VSIM_SDK_RENDERER)
  foreach(target IN ITEMS glfw Vulkan::Vulkan)
    foreach(property IN ITEMS IMPORTED_LOCATION_RELEASE IMPORTED_LOCATION_NOCONFIG IMPORTED_LOCATION)
      get_target_property(location ${target} ${property})
      if(location)
        list(APPEND VSIM_RENDERER_LIBRARIES "${location}")
        break()
      endif()
    endforeach()
  endforeach()
endif()
check_required_components(vsim)
